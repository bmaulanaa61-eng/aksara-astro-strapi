{
  "collectionName": "components_sections_featured_projects",
  "info": {
    "displayName": "Featured Projects",
    "description": "Heading plus curated project case studies"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "intro": {
      "type": "text",
      "required": false,
      "maxLength": 400
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "limit": {
      "type": "integer",
      "required": true,
      "default": 3,
      "min": 1,
      "max": 6
    }
  }
}
