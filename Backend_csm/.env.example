# Copy to .env and fill in. Never commit .env.

# ── Server ──
HOST=0.0.0.0
PORT=1337

# ── Secrets ──
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS takes four comma-separated values.
APP_KEYS=change_me_1,change_me_2,change_me_3,change_me_4
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me

# ── Database (PostgreSQL only) ──
# Either set DATABASE_URL, or the individual fields below.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=aksara_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_SSL=false

# ── AI Assistant (any OpenAI-compatible endpoint) ──
# Leave AI_API_KEY empty to run without AI; the admin panel will say AI is not configured.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=auto/best-chat
AI_FALLBACK_MODEL=auto/pro-chat
AI_TIMEOUT_MS=45000
