---
import BaseLayout from '../layouts/BaseLayout.astro'; import DetailHero from './DetailHero.astro'; import ArticleCard from './ArticleCard.astro'; import { getContent } from '../lib/strapi'; import { copy,formatDate,routes } from '../lib/i18n'; import { alternateEntryPath,entryPath } from '../lib/paths'; import { readingTime,withHeadingIds } from '../lib/rich-text'; import type { Article,Locale } from '../lib/types'; interface Props{locale:Locale;item:Article} const{locale,item}=Astro.props;const c=copy[locale];const body=withHeadingIds(item.content);const content=getContent(locale);const related=content.articles.filter(x=>x.documentId!==item.documentId&&x.tags.some(t=>item.tags.some(tag=>tag.documentId===t.documentId))).slice(0,3);const alternate=alternateEntryPath(locale,'article',item.documentId,locale==='id'?routes.en.insights:routes.id.insights);const articleUrl=entryPath(locale,'article',item.slug);const jsonLd={"@context":"https://schema.org","@type":"Article",headline:item.title,description:item.summary,datePublished:item.publishedAt,author:{"@type":"Organization",name:item.author?.name||'Aksara Editorial'},inLanguage:locale,url:new URL(articleUrl,Astro.site)};
---
<BaseLayout locale={locale} seo={item.seo} alternatePath={alternate} structuredData={jsonLd} openGraphType="article"><DetailHero eyebrow={locale==='id'?'Wawasan':'Insights'} title={item.title} intro={item.summary||item.seo.metaDescription} meta={`${formatDate(item.publishedAt,locale)} · ${readingTime(item.content)} ${c.minutes}`}/>{item.summary&&<section class="summary wrap"><div><span>{c.summary}</span><small>{c.aiReviewed}</small></div><p>{item.summary}</p></section>}<section class="section article"><div class="wrap article-grid"><aside>{body.headings.length>0&&<nav aria-label={c.contents}><strong>{c.contents}</strong>{body.headings.map(h=><a href={`#${h.id}`}>{h.text}</a>)}</nav>}</aside><article class="rich-text" set:html={body.html}/><aside class="author"><span>{c.by}</span><strong>{item.author?.name||'Aksara Editorial'}</strong>{item.author?.role&&<small>{item.author.role}</small>}{item.author?.bio&&<p>{item.author.bio}</p>}<div class="tag-list">{item.tags.map(tag=><a class="tag" href={entryPath(locale,'tag',tag.slug)}>{tag.name}</a>)}</div></aside></div></section>{related.length>0&&<section class="section"><div class="wrap"><div class="section-head"><h2>{c.related}</h2></div><div class="cards">{related.map(x=><ArticleCard item={x} locale={locale}/>)}</div></div></section>}</BaseLayout>
<style>.summary{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding:2rem;border:1px solid var(--line);background:var(--white)}.summary div{display:grid;align-content:start}.summary span{font-family:var(--font-display);font-size:1.6rem}.summary small{color:var(--muted)}.summary p{margin:0;font-family:var(--font-display);font-size:1.4rem}.article-grid{display:grid;grid-template-columns:minmax(9rem,.55fr) minmax(0,2fr) minmax(12rem,.7fr);gap:clamp(2rem,5vw,5rem);align-items:start}.article nav{display:grid;gap:.7rem;position:sticky;top:2rem}.article nav a{font-size:.85rem;color:var(--muted)}.author{border-top:2px solid var(--ink);padding-top:1rem;display:grid}.author span,.author small{color:var(--muted);font-size:.8rem}.author p{font-size:.9rem}.author .tag-list{margin-top:1rem}@media(max-width:900px){.article-grid{grid-template-columns:1fr}.article nav{position:static}.summary{grid-template-columns:1fr}}</style>
