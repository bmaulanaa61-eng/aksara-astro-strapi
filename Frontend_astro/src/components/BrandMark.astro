---
import { Image } from 'astro:assets';
import logo from '../assets/logo-aksara.png';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={['brand', { compact }]} aria-label="Aksara"><Image src={logo} alt="" width={74} height={68} class="mark" /><span class="word">Aksara</span></span>
<style>
  .brand{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--font-display);font-size:1.4rem;font-weight:700;letter-spacing:-.03em}.mark{height:2.15rem;width:auto;display:block}.compact .word{display:none}
</style>
