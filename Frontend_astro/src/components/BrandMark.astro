---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={['brand', { compact }]} aria-label="Aksara"><span aria-hidden="true" class="glyph">A</span><span class="word">Aksara</span></span>
<style>
  .brand{display:inline-flex;align-items:center;gap:.65rem;font-family:var(--font-display);font-size:1.4rem;font-weight:700;letter-spacing:-.03em}.glyph{display:grid;place-items:center;width:2rem;height:2rem;background:var(--ink);color:var(--paper);font-size:1rem;position:relative}.glyph:after{content:"";position:absolute;width:.42rem;height:.42rem;border-radius:50%;background:var(--clay);right:-.18rem;top:-.18rem}.compact .word{display:none}
</style>
