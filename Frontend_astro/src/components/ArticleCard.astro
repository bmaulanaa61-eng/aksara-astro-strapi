---
import { Image } from 'astro:assets';
import insightImage from '../assets/insight-strapi-snapshot.png';
import type { Article, Locale } from '../lib/types'; import { copy, formatDate } from '../lib/i18n'; import { entryPath } from '../lib/paths'; import { readingTime } from '../lib/rich-text'; interface Props { item: Article; locale: Locale } const { item, locale }=Astro.props;
---
<article class="card article-card"><div class="card-visual">{item.cover ? <img src={item.cover.url} alt={item.cover.alternativeText || ''} loading="lazy" width={item.cover.width} height={item.cover.height}/> : <Image src={insightImage} alt={`Ilustrasi artikel ${item.title}`} widths={[360,540]} sizes="(max-width: 800px) 100vw, 33vw" loading="lazy"/>}</div><div class="meta"><time datetime={item.publishedAt}>{formatDate(item.publishedAt,locale)}</time> · {readingTime(item.content)} {copy[locale].minutes}</div><h3>{item.title}</h3>{item.summary && <p>{item.summary}</p>}<div class="tag-list">{item.tags.map((tag)=><span class="tag">{tag.name}</span>)}</div><a aria-label={`${copy[locale].readMore}: ${item.title}`} href={entryPath(locale,'article',item.slug)}>{copy[locale].readMore} <span aria-hidden="true">→</span></a></article>
<style>.article-card a{margin-top:1.5rem;font-weight:600}.article-card .tag-list{margin-top:auto}.article-card h3{margin-top:1.25rem}.card-visual{height:8rem;margin:-2rem -2rem 1.5rem;border-bottom:1px solid var(--line);overflow:hidden;background:#eef2f1}.card-visual :global(img){width:100%;height:100%;object-fit:cover}</style>
