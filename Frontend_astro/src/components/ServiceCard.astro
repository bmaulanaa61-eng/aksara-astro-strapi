---
import { Image } from 'astro:assets';
import webDesign from '../assets/service-web-design.png';
import astroStrapi from '../assets/service-astro-strapi.png';
import bilingual from '../assets/service-bilingual-content.png';
import type { Locale, Service } from '../lib/types'; import { copy } from '../lib/i18n'; import { entryPath } from '../lib/paths';
interface Props { item: Service; locale: Locale } const { item, locale } = Astro.props;
const symbols: Record<string,string>={design:'✦',engineering:'⌁',content:'¶',seo:'↗',brand:'A',support:'+'};
const art = item.icon === 'engineering' ? astroStrapi : item.icon === 'content' ? bilingual : webDesign;
---
<article class="card"><div class="card-art"><Image src={art} alt={`Ilustrasi layanan ${item.title}`} widths={[360,540]} sizes="(max-width: 800px) 100vw, 33vw" loading="lazy"/></div><div class="meta">{symbols[item.icon] || '•'} &nbsp; {String(item.order).padStart(2,'0')}</div><h3>{item.title}</h3><p>{item.summary}</p><a aria-label={`${copy[locale].readMore}: ${item.title}`} href={entryPath(locale,'service',item.slug)}>{copy[locale].readMore} <span aria-hidden="true">→</span></a></article>
<style>.card-art{height:8.5rem;margin:-2rem -2rem 1.5rem;border-bottom:1px solid var(--line);overflow:hidden;background:#eef2f1}.card-art :global(img){width:100%;height:100%;object-fit:cover}a{margin-top:1rem;font-weight:600}.meta{font-size:1.4rem!important;color:var(--clay)}</style>
