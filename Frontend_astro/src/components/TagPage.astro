---
import BaseLayout from '../layouts/BaseLayout.astro'; import ListingHero from './ListingHero.astro'; import ArticleCard from './ArticleCard.astro'; import { getContent } from '../lib/strapi'; import { alternateEntryPath } from '../lib/paths'; import { routes } from '../lib/i18n'; import type {Locale,Tag} from '../lib/types'; interface Props{locale:Locale;tag:Tag}const{locale,tag}=Astro.props;const content=getContent(locale);const articles=content.articles.filter(x=>x.tags.some(t=>t.documentId===tag.documentId));const alternate=alternateEntryPath(locale,'tag',tag.documentId,locale==='id'?routes.en.insights:routes.id.insights);const intro=locale==='id'?`Semua wawasan dengan topik ${tag.name}.`:`All insights filed under ${tag.name}.`;
---
<BaseLayout locale={locale} seo={{metaTitle:`${tag.name} — Aksara`,metaDescription:intro}} alternatePath={alternate}><ListingHero title={tag.name} intro={intro} count={articles.length}/><section class="section"><div class="wrap"><h2 class="sr-only">{locale === 'id' ? 'Daftar wawasan' : 'Insight list'}</h2><div class="cards">{articles.map(item=><ArticleCard item={item} locale={locale}/>)}</div></div></section></BaseLayout>
