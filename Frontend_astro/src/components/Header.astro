---
import BrandMark from './BrandMark.astro';
import type { Global, Locale } from '../lib/types';
import { copy } from '../lib/i18n';
interface Props { locale: Locale; global: Global; alternatePath: string }
const { locale, global, alternatePath } = Astro.props;
---
<header class="site-header"><div class="wrap header-inner"><a class="home" href={locale === 'id' ? '/' : '/en/'}><BrandMark /></a><nav aria-label={locale === 'id' ? 'Navigasi utama' : 'Primary navigation'}>{global.primaryNav.map((item) => <a href={item.url}>{item.label}</a>)}</nav><a class="language" href={alternatePath} hreflang={locale === 'id' ? 'en' : 'id'} lang={locale === 'id' ? 'en' : 'id'}>{copy[locale].language} <span aria-hidden="true">↗</span></a></div></header>
<style>
.site-header{position:relative;z-index:10;border-bottom:1px solid var(--line)}.header-inner{min-height:5.3rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem}.home{width:max-content;text-decoration:none}.home:hover{color:inherit}nav{display:flex;gap:2rem}nav a,.language{font-size:.9rem;font-weight:600;text-decoration:none}.language{justify-self:end;font-family:var(--font-mono);font-size:.7rem;letter-spacing:.08em;padding:.35rem .55rem;border:1px solid var(--line);transition:border-color .2s,color .2s}.language:hover{border-color:var(--clay);color:var(--clay)}@media(max-width:720px){.header-inner{grid-template-columns:1fr auto;min-height:4.5rem}nav{grid-column:1/-1;grid-row:2;padding:.8rem 0 1rem;display:flex;gap:1.25rem;justify-content:flex-start;overflow-x:auto;white-space:nowrap;border-top:1px solid var(--line);scrollbar-width:none}nav::-webkit-scrollbar{display:none}.language{grid-column:2;grid-row:1}}
</style>
