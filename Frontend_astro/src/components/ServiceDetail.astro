---
import BaseLayout from '../layouts/BaseLayout.astro'; import DetailHero from './DetailHero.astro'; import { renderRichText } from '../lib/rich-text'; import { alternateEntryPath } from '../lib/paths'; import { routes } from '../lib/i18n'; import type { Locale,Service } from '../lib/types'; interface Props { locale:Locale; item:Service } const {locale,item}=Astro.props; const alternate=alternateEntryPath(locale,'service',item.documentId,locale==='id'?routes.en.services:routes.id.services);
---
<BaseLayout locale={locale} seo={item.seo} alternatePath={alternate}><DetailHero eyebrow={locale==='id'?'Layanan Aksara':'Aksara service'} title={item.title} intro={item.summary} meta={`0${item.order} / 03`}/><section class="section"><div class="wrap detail-grid"><aside><p>{locale==='id'?'Yang kami kerjakan':'What we do'}</p><span aria-hidden="true">{item.icon==='design'?'✦':item.icon==='content'?'¶':'⌁'}</span></aside><article class="rich-text" set:html={renderRichText(item.body)}/></div></section></BaseLayout>
<style>.detail-grid{display:grid;grid-template-columns:1fr 2fr;gap:4rem}.detail-grid aside{border-top:2px solid var(--ink)}aside p{font-weight:600}aside span{font-size:6rem;color:var(--clay)}article{max-width:45rem}@media(max-width:700px){.detail-grid{grid-template-columns:1fr}}</style>
