---
import { Image } from 'astro:assets';
import webDesign from '../assets/service-web-design.png';
import astroStrapi from '../assets/service-astro-strapi.png';
import bilingual from '../assets/service-bilingual-content.png';
import BaseLayout from '../layouts/BaseLayout.astro'; import DetailHero from './DetailHero.astro'; import { renderRichText } from '../lib/rich-text'; import { alternateEntryPath } from '../lib/paths'; import { routes } from '../lib/i18n'; import type { Locale,Service } from '../lib/types'; interface Props { locale:Locale; item:Service } const {locale,item}=Astro.props; const alternate=alternateEntryPath(locale,'service',item.documentId,locale==='id'?routes.en.services:routes.id.services);
const art = item.icon === 'engineering' ? astroStrapi : item.icon === 'content' ? bilingual : webDesign;
---
<BaseLayout locale={locale} seo={item.seo} alternatePath={alternate}><DetailHero eyebrow={locale==='id'?'Layanan Aksara':'Aksara service'} title={item.title} intro={item.summary} meta={`0${item.order} / 03`}/><figure class="wrap service-art"><Image src={art} alt={`Ilustrasi layanan ${item.title}`} widths={[720,1100]} sizes="min(1180px, 100vw)" loading="lazy"/></figure><section class="section"><div class="wrap detail-grid"><aside><p>{locale==='id'?'Yang kami kerjakan':'What we do'}</p><span aria-hidden="true">{item.icon==='design'?'✦':item.icon==='content'?'¶':'⌁'}</span></aside><article class="rich-text" set:html={renderRichText(item.body)}/></div></section></BaseLayout>
<style>.service-art{margin:0 auto 4rem;border:1px solid var(--line);background:var(--white);box-shadow:var(--shadow);overflow:hidden;aspect-ratio:4/3}.service-art :global(img){display:block;width:100%;height:100%;object-fit:cover}.detail-grid{display:grid;grid-template-columns:1fr 2fr;gap:4rem}.detail-grid aside{border-top:2px solid var(--ink)}aside p{font-weight:600}aside span{font-size:6rem;color:var(--clay)}article{max-width:45rem}@media(max-width:700px){.detail-grid{grid-template-columns:1fr}.service-art{margin-bottom:2rem}}
</style>
