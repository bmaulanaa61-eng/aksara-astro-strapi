---
import { Image } from 'astro:assets';
import heroImage from '../assets/aksara-hero.png';
import ServiceCard from './ServiceCard.astro'; import ProjectCard from './ProjectCard.astro'; import ArticleCard from './ArticleCard.astro';
import SystemDiagram from './SystemDiagram.astro';
import { getContent } from '../lib/strapi'; import { renderRichText } from '../lib/rich-text'; import { copy, routes } from '../lib/i18n'; import type { Locale, PageSection } from '../lib/types';
interface Props { locale: Locale; sections: PageSection[] } const { locale,sections }=Astro.props; const content=getContent(locale);
---
{sections.map((section,index)=>{
if(section.__component==='sections.hero') return <><section class="hero wrap"><div class="hero-index" aria-hidden="true">A/{String(index+1).padStart(2,'0')}</div><div class="hero-copy">{section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}<h1>{section.heading}</h1>{section.subheading&&<p class="lead">{section.subheading}</p>}<div class="actions">{section.primaryCta&&<a class="button primary" href={section.primaryCta.url} target={section.primaryCta.openInNewTab?'_blank':undefined} rel={section.primaryCta.openInNewTab?'noopener noreferrer':undefined}>{section.primaryCta.label}</a>}{section.secondaryCta&&<a class="button secondary" href={section.secondaryCta.url}>{section.secondaryCta.label}</a>}</div></div><div class="hero-art"><Image src={heroImage} alt="Struktur abstrak berbentuk A dengan material kaca biru dan garis sirkuit" widths={[520,800,1100]} sizes="(max-width: 750px) calc(100vw - 1.5rem), 38vw" class="hero-image" priority /><div class="hero-meta" aria-hidden="true"><span>SYS / STRAPI</span><span>AI / ASSIST</span><span>BUILD / ASTRO</span></div></div></section><SystemDiagram locale={locale}/></>;
if(section.__component==='sections.services-grid'){const items=content.services.filter(x=>section.serviceIds.includes(x.documentId)).slice(0,section.limit);return <section class="section"><div class="wrap"><div class="section-head"><h2>{section.heading}</h2>{section.intro&&<p>{section.intro}</p>}</div><div class="cards">{items.map(item=><ServiceCard item={item} locale={locale}/>)}</div><a class="more" href={routes[locale].services}>{copy[locale].allServices} →</a></div></section>}
if(section.__component==='sections.featured-projects'){const items=content.projects.filter(x=>section.projectIds.includes(x.documentId)).slice(0,section.limit);return <section class="section"><div class="wrap"><div class="section-head"><h2>{section.heading}</h2>{section.intro&&<p>{section.intro}</p>}</div>{items.map(item=><ProjectCard item={item} locale={locale}/>)}<a class="more" href={routes[locale].work}>{copy[locale].allWork} →</a></div></section>}
if(section.__component==='sections.latest-articles'){const items=content.articles.filter(x=>section.articleIds.includes(x.documentId)).slice(0,section.limit);return <section class="section"><div class="wrap"><div class="section-head"><h2>{section.heading}</h2>{section.intro&&<p>{section.intro}</p>}</div><div class="cards">{items.map(item=><ArticleCard item={item} locale={locale}/>)}</div><a class="more" href={routes[locale].insights}>{copy[locale].allInsights} →</a></div></section>}
if(section.__component==='sections.stats')return <section class="section stats"><div class="wrap">{section.heading&&<h2>{section.heading}</h2>}<div class="stat-grid">{section.items.map(item=><div class="stat"><strong>{item.value}</strong><h3>{item.label}</h3>{item.context&&<p>{item.context}</p>}</div>)}</div></div></section>;
if(section.__component==='sections.rich-text')return <section class="section"><div class="wrap prose">{section.heading&&<h2>{section.heading}</h2>}<div class="rich-text" set:html={renderRichText(section.body)}/></div></section>;
if(section.__component==='sections.faq')return <section class="section"><div class="wrap faq"><div><h2>{section.heading}</h2>{section.intro&&<p>{section.intro}</p>}</div><div>{section.items.map(item=><details><summary>{item.question}<span>+</span></summary><div set:html={renderRichText(item.answer)}/></details>)}</div></div></section>;
return section.__component==='sections.cta'?<section class="section cta"><div class="wrap cta-inner"><div><h2>{section.heading}</h2>{section.body&&<p>{section.body}</p>}</div><div class="actions"><a class="button primary" href={section.primaryCta.url} target={section.primaryCta.openInNewTab?'_blank':undefined} rel={section.primaryCta.openInNewTab?'noopener noreferrer':undefined}>{section.primaryCta.label}</a>{section.secondaryCta&&<a class="button secondary" href={section.secondaryCta.url}>{section.secondaryCta.label}</a>}</div></div></section>:null;
})}
<style>.hero{min-height:calc(100vh - 5.3rem);padding:clamp(4rem,7vw,6rem) 0;display:grid;grid-template-columns:9rem minmax(0,1.15fr) minmax(17rem,.85fr);gap:clamp(2rem,5vw,5rem);align-items:center}.hero-art{position:relative;width:100%;aspect-ratio:4/3;border:1px solid var(--line);background:var(--white);overflow:hidden;box-shadow:var(--shadow)}.hero-art :global(picture),.hero-art :global(img){display:block;width:100%;height:100%}.hero-art :global(img){position:absolute;inset:0;object-fit:cover;object-position:60% center}.hero-index{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.14em;border-top:2px solid var(--ink);padding-top:.7rem}.hero-meta{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;gap:.5rem;padding:.7rem .9rem;font-family:var(--font-mono);font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);background:linear-gradient(0deg,rgba(255,253,248,.94),rgba(255,253,248,0))}.hero-copy h1{max-width:13ch;margin:.25em 0}.lead{font-size:clamp(1.1rem,2vw,1.4rem);color:var(--muted);max-width:43rem}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.more{display:block;width:max-content;margin:2rem 0 0 auto;font-weight:600}.stats{background:var(--ink);color:var(--paper)}.stats h2{margin-bottom:3rem}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #455048}.stat{padding:2rem 2rem 0 0}.stat+.stat{border-left:1px solid #455048;padding-left:2rem}/* --clay-on-ink = 4.33:1 on --ink; plain --clay only reaches 2.82:1 there */ .stat strong{font-family:var(--font-display);font-size:clamp(4rem,9vw,8rem);font-weight:500;color:var(--clay-on-ink)}.stat h3{margin:.25rem 0}.stat p{color:#aeb7b0}.prose{max-width:50rem}.faq{display:grid;grid-template-columns:.7fr 1.3fr;gap:5rem}details{border-top:1px solid var(--line);padding:1.25rem 0}details:last-child{border-bottom:1px solid var(--line)}summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;font-family:var(--font-display);font-size:1.45rem}summary span{color:var(--clay)}.cta{background:var(--clay);color:var(--white);border:0}.cta-inner{display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:end}.cta h2{max-width:14ch}.cta p{font-size:1.1rem}.cta .button.primary{background:var(--paper);color:var(--ink);border-color:var(--paper)}@media(max-width:750px){.hero{grid-template-columns:1fr;min-height:auto}.hero-index{display:none}.hero-art{width:100%;min-height:0;aspect-ratio:16/10}.hero-art :global(img){object-position:center}.stat-grid,.faq,.cta-inner{grid-template-columns:1fr}.stat+.stat{border-left:0;border-top:1px solid #455048;padding-left:0}.faq{gap:2rem}}</style>
