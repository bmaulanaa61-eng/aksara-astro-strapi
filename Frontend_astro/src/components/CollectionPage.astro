---
import BaseLayout from '../layouts/BaseLayout.astro'; import ListingHero from './ListingHero.astro'; import ServiceCard from './ServiceCard.astro'; import ProjectCard from './ProjectCard.astro'; import ArticleCard from './ArticleCard.astro'; import { getContent } from '../lib/strapi'; import { routes } from '../lib/i18n'; import type { Locale } from '../lib/types';
interface Props { locale: Locale; type: 'services'|'projects'|'articles' } const { locale,type }=Astro.props; const content=getContent(locale); const items=type==='services'?content.services:type==='projects'?content.projects:content.articles; const c=locale==='id'?{services:['Layanan','Sistem desain, engineering, dan konten yang dibangun untuk website agency yang terukur.'],projects:['Proyek','Case study jujur tentang keputusan teknis dan batasan proyek portofolio.'],articles:['Wawasan','Catatan praktis tentang Astro, Strapi, SEO, dan alur editorial.']}:{services:['Services','Design, engineering, and content systems for focused agency websites.'],projects:['Work','Honest case studies about technical decisions and portfolio constraints.'],articles:['Insights','Practical notes on Astro, Strapi, SEO, and editorial workflow.']}; const current=c[type]; const alternate=locale==='id'?routes.en[type==='projects'?'work':type==='articles'?'insights':'services']:routes.id[type==='projects'?'work':type==='articles'?'insights':'services']; const seo={metaTitle:`${current[0]} — Aksara`,metaDescription:current[1]};
---
<BaseLayout locale={locale} seo={seo} alternatePath={alternate}><ListingHero title={current[0]} intro={current[1]} count={items.length}/><section class="section"><div class="wrap"><h2 class="sr-only">{current[0]}</h2>{type==='projects'?<div class="stack">{content.projects.map(item=><ProjectCard item={item} locale={locale}/>)}</div>:<div class="cards">{type==='services'?content.services.map(item=><ServiceCard item={item} locale={locale}/>):content.articles.map(item=><ArticleCard item={item} locale={locale}/>)}</div>}</div></section></BaseLayout>
<style>.stack{display:grid;gap:2rem}</style>
