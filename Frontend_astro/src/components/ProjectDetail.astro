---
import BaseLayout from '../layouts/BaseLayout.astro'; import DetailHero from './DetailHero.astro'; import { renderRichText } from '../lib/rich-text'; import { alternateEntryPath } from '../lib/paths'; import { routes } from '../lib/i18n'; import type { Locale,Project } from '../lib/types'; interface Props { locale:Locale; item:Project } const {locale,item}=Astro.props; const alternate=alternateEntryPath(locale,'project',item.documentId,locale==='id'?routes.en.work:routes.id.work);
---
<BaseLayout locale={locale} seo={item.seo} alternatePath={alternate}><DetailHero eyebrow={locale==='id'?'Case study fiktif':'Fictional case study'} title={item.title} intro={item.summary} meta={`${item.client} · ${item.year}`}/><div class="wrap project-art" aria-hidden="true">A/{String(item.year).slice(-2)}</div><section class="section"><div class="wrap detail-grid"><aside>{item.facts.map(fact=><div><span>{fact.label}</span><strong>{fact.value}</strong></div>)}</aside><article class="rich-text" set:html={renderRichText(item.body)}/></div></section></BaseLayout>
<style>.project-art{min-height:clamp(18rem,45vw,38rem);display:grid;place-items:center;background:var(--sage);font-family:var(--font-display);font-size:clamp(6rem,22vw,19rem);letter-spacing:-.08em;overflow:hidden}.detail-grid{display:grid;grid-template-columns:1fr 2fr;gap:5rem}.detail-grid aside div{padding:1rem 0;border-top:1px solid var(--line);display:grid;gap:.25rem}.detail-grid aside span{font-size:.8rem;color:var(--muted)}.detail-grid aside strong{font-weight:500}.rich-text{max-width:45rem}@media(max-width:700px){.detail-grid{grid-template-columns:1fr}}</style>
