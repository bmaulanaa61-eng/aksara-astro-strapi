---
import { Image } from 'astro:assets';
import systemMockup from '../assets/aksara-system-mockup.jpg';
import type { Locale, Project } from '../lib/types'; import { copy } from '../lib/i18n'; import { entryPath } from '../lib/paths'; interface Props { item: Project; locale: Locale } const { item, locale }=Astro.props;
---
<article class="project"><div class="visual">{item.cover ? <img src={item.cover.url} alt={item.cover.alternativeText || ''} loading="lazy" width={item.cover.width} height={item.cover.height}/> : <Image src={systemMockup} alt="Diagram integrasi Strapi, Astro, database, dan AI Assistant pada Aksara" widths={[420,800]} sizes="(max-width: 750px) 100vw, 67vw" loading="lazy"/>}</div><div class="project-copy"><p class="meta">{item.client} · {item.year}</p><h3>{item.title}</h3><p>{item.summary}</p><a aria-label={`${copy[locale].readMore}: ${item.title}`} href={entryPath(locale,'project',item.slug)}>{copy[locale].readMore} <span aria-hidden="true">→</span></a></div></article>
<style>.project{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr);border:1px solid var(--line);background:var(--white);box-shadow:var(--shadow)}.visual{min-height:25rem;background:linear-gradient(135deg,#d9f6f7,#e8e1ff);display:grid;place-items:center;overflow:hidden}.visual :global(img){width:100%;height:100%;object-fit:cover}.project-copy{padding:clamp(2rem,5vw,4rem);display:flex;flex-direction:column;justify-content:center}.project-copy h3{font-size:clamp(2rem,4vw,3.6rem);margin:.5rem 0}.project-copy p{color:var(--muted)}.project-copy a{font-weight:600;margin-top:1rem}@media(max-width:750px){.project{grid-template-columns:1fr}.visual{min-height:16rem;aspect-ratio:4/3}}
</style>
